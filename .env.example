# Node Environment
NODE_ENV=development

# Database URL
# For local development with Docker: postgresql://postgres:postgres@postgres/app
# For production: Use your production database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Base URLs (optional)
BASE_URL=http://localhost:3000
BASE_URL_OTHER_PORT=

# JWT Secret (CHANGE IN PRODUCTION!)
JWT_SECRET=your-secret-jwt-key-change-this-in-production

# Admin Password for htpasswd authentication
ADMIN_PASSWORD=your-admin-password

# Email Configuration (Resend API)
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=noreply@yourdomain.com

# MinIO Configuration (for file storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=callsheet-uploads
